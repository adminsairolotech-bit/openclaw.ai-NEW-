# OpenClaw Server Configuration for Railway
# Add your environment variables in Railway dashboard

# ===================
# Required Variables
# ===================

# Gateway authentication token (generate a secure random string)
OPENCLAW_TOKEN=your-secure-token-here

# ===================
# Optional - LLM Provider
# ===================

# Provider: openai, anthropic, google, azure, ollama, etc.
OPENCLAW_LLM_PROVIDER=openai
OPENCLAW_LLM_MODEL=gpt-4o

# API Keys
OPENCLAW_API_KEY=sk-your-openai-key
GOOGLE_API_KEY=your-google-api-key
NVIDIA_API_KEY=your-nvidia-api-key

# ===================
# Server Configuration
# ===================

# Network
PORT=18789
HOST=0.0.0.0

# Features
OPENCLAW_SANDBOX=1
OPENCLAW_EXTENSIONS=